#!/usr/bin/env bash
# PostToolUse hook on Bash: after `gh pr create` opens a pull request, ask
# Claude to offer /dev:babysit-pr to the user. babysit-pr is manual-only, so
# this only suggests it; it never starts it. Off with BABYSIT_SUGGEST=never.
#
# A repository that opens PRs through its own wrapper names it in
# BABYSIT_PR_OPENERS, comma-separated, e.g. "mk pr open,maneki pr open". Each
# opener's first word may be called by path (bin/mk). An opener only decides
# that the call opened a PR; the URL is still taken from the output.
# Reads the hook payload on stdin; prints hook JSON or nothing; always exits 0
# so a broken hook never blocks the session.

[ "${BABYSIT_SUGGEST:-}" = never ] && exit 0
command -v jq >/dev/null || exit 0

payload=$(cat)
cmd=$(jq -r '.tool_input.command // empty' <<<"$payload" 2>/dev/null) || exit 0

# `gh pr create`, or its alias `gh pr new`, anywhere in the command line
opens='(^|[^[:alnum:]_./-])gh[[:space:]]+pr[[:space:]]+(create|new)([^[:alnum:]_-]|$)'
# Each declared opener as a pattern: its words literal, blanks between them.
# Unlike gh, a / may precede it, which is what lets bin/mk match.
IFS=, read -ra openers <<<"${BABYSIT_PR_OPENERS:-}"
for opener in "${openers[@]+"${openers[@]}"}"; do
  read -ra words <<<"$opener"
  [ "${#words[@]}" -gt 0 ] || continue
  re=""
  for w in "${words[@]}"; do
    w=$(sed 's/[][\\.*^$+?(){}|/]/\\&/g' <<<"$w")
    re+="${re:+[[:space:]]+}$w"
  done
  opens+="|(^|[^[:alnum:]_.-])$re([^[:alnum:]_-]|\$)"
done
grep -Eq "$opens" <<<"$cmd" || exit 0

# The last PR URL gh printed. Only this strict shape reaches Claude, never the
# raw output.
url=$(jq -r '[.tool_response | .. | strings] | join("\n")' <<<"$payload" 2>/dev/null |
  grep -Eo 'https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[0-9]+' | tail -1)
[ -n "$url" ] || exit 0

jq -nc --arg url "$url" '{hookSpecificOutput: {hookEventName: "PostToolUse",
  additionalContext: ("A pull request was just opened: " + $url + ". At the end of your reply, tell the user once that they can run `/dev:babysit-pr " + $url + "` to drive it to mergeable unattended. Do not try to start it yourself: it is manual-only.")}}'
exit 0
