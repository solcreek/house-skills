#!/usr/bin/env bash
# PostToolUse hook on Bash: after `gh pr create` opens a pull request, ask
# Claude to offer /dev:babysit-pr to the user. babysit-pr is manual-only, so
# this only suggests it; it never starts it. Off with BABYSIT_SUGGEST=never.
#
# A repository that opens PRs through its own wrapper declares it as babysit-pr's
# `pr-open` capability (see the skill's scripts/repo-commands), read here from
# the checkout the call ran in. The opener is the command's words before its
# first option or placeholder, its first word matched by name, so bin/mk, ./bin/mk
# and mk all match "bin/mk pr open". BABYSIT_PR_OPENERS, comma-separated, is
# the older way to name openers and still counts. An opener only decides that
# the call opened a PR; the URL is still taken from the output.
# Reads the hook payload on stdin; prints hook JSON or nothing; always exits 0
# so a broken hook never blocks the session.

[ "${BABYSIT_SUGGEST:-}" = never ] && exit 0
command -v jq >/dev/null || exit 0

payload=$(cat)
cmd=$(jq -r '.tool_input.command // empty' <<<"$payload" 2>/dev/null) || exit 0

# The last PR URL in the output. Only this strict shape reaches Claude, never
# the raw output. Checked first: most calls print none, and then nothing else
# needs reading.
url=$(jq -r '[.tool_response | .. | strings] | join("\n")' <<<"$payload" 2>/dev/null |
  grep -Eo 'https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[0-9]+' | tail -1)
[ -n "$url" ] || exit 0

openers=()
IFS=, read -ra openers <<<"${BABYSIT_PR_OPENERS:-}"
reader=$(cd "$(dirname "$0")/../skills/babysit-pr/scripts" 2>/dev/null && pwd)/repo-commands
cwd=$(jq -r '.cwd // empty' <<<"$payload" 2>/dev/null) || cwd=""
declared=$(cd "${cwd:-.}" 2>/dev/null && "$reader" --worktree 2>/dev/null |
  jq -r '.["pr-open"].command // empty' 2>/dev/null) || declared=""
if [ -n "$declared" ]; then
  read -ra words <<<"$declared"
  opener=""
  for w in "${words[@]}"; do
    case $w in -* | *"{"*) break ;; esac
    if [ -z "$opener" ]; then opener=${w##*/}; else opener+=" $w"; fi
  done
  openers+=("$opener")
fi

# `gh pr create`, or its alias `gh pr new`, anywhere in the command line
opens='(^|[^[:alnum:]_./-])gh[[:space:]]+pr[[:space:]]+(create|new)([^[:alnum:]_-]|$)'
# Each opener as a pattern: its words literal, blanks between them. Unlike gh,
# a / may precede it, which is what lets bin/mk match; nothing word-like may
# follow it, so open.sh or open/x is not open.
for opener in "${openers[@]+"${openers[@]}"}"; do
  read -ra words <<<"$opener"
  [ "${#words[@]}" -gt 0 ] || continue
  re=""
  for w in "${words[@]}"; do
    w=$(sed 's/[][\\.*^$+?(){}|]/\\&/g' <<<"$w")
    re+="${re:+[[:space:]]+}$w"
  done
  opens+="|(^|[^[:alnum:]_.-])$re([^[:alnum:]_./-]|\$)"
done
grep -Eq "$opens" <<<"$cmd" || exit 0

jq -nc --arg url "$url" '{hookSpecificOutput: {hookEventName: "PostToolUse",
  additionalContext: ("A pull request was just opened: " + $url + ". At the end of your reply, tell the user once that they can run `/dev:babysit-pr " + $url + "` to drive it to mergeable unattended. Do not try to start it yourself: it is manual-only.")}}'
exit 0
