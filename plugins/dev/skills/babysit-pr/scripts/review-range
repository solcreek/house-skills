#!/usr/bin/env bash
# review-range BASE SINCE
#
# What step 5 reviews when SINCE..HEAD is not all the agent's own work. A merge
# of the base branch brings the base's commits into the range: reviewing
# SINCE..HEAD whole would review everything the base gained since the branch
# last merged it (2,857 files once, around a one-file fix). The range is split
# at each merge whose other parents are all on origin/BASE (an octopus that
# also brings in another branch is not split at: that branch's changes would
# fall between segments):
#
#   {"since": S, "segments": [{"since": A, "head": B}, ...], "merges": [M, ...],
#    "reviewer": {...}}
#
#   since     review S..HEAD with the reviewer: the commits after the last merge
#   segments  the agent's commits before a merge, older first; each is reviewed
#             as A..B by the subagent, which can take any range
#   merges    each merge's own resolution, read with `git show --remerge-diff M`
#             (empty when the merge resolved itself)
#   reviewer  who reviews S..HEAD, from local-reviewer: {"kind": "repository",
#             "command": ..., "source": ...} with S filled in, or
#             {"kind": "subagent", "why": ...} when the repository declares
#             none or its declaration could not be used. One call answers both
#             questions, so the reviewer is never left unasked.
#
# With no such merge in the range: since is SINCE, segments and merges empty.
# The same when SINCE is the merge base of origin/BASE and HEAD (the default
# for a PR never reviewed): SINCE..HEAD is then exactly the PR's own change,
# even after earlier merges of the base, which leave SINCE off the first-parent
# line.
#
# Exit codes: 0 the JSON above · 1 could not tell (origin/BASE missing, SINCE
# not on HEAD's first-parent line; message on stderr) · 2 usage
set -euo pipefail

usage="usage: review-range BASE SINCE"
base=${1:?$usage}
since=${2:?$usage}
[[ "$since" =~ ^[0-9a-f]{7,40}$ ]] || { echo "review-range: SINCE must be a commit sha" >&2; exit 2; }
command -v jq >/dev/null || { echo "review-range needs jq" >&2; exit 1; }
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# answer SINCE MERGES-JSON SEGMENTS-JSON — prints the result with its reviewer
answer() {
  local out err rc=0 reviewer
  # stdout and stderr apart: a git warning on stderr must not reach the JSON.
  err=$(mktemp)
  out=$("$here/local-reviewer" "$base" "$1" 2>"$err") || rc=$?
  case $rc in
    0) reviewer=$(jq -c '{kind: "repository"} + .' <<<"$out") ;;
    3) reviewer='{"kind": "subagent", "why": "nothing declared"}' ;;
    *) reviewer=$(jq -nc --arg why "$(tail -n 1 "$err")" '{kind: "subagent", why: $why}') ;;
  esac
  rm -f "$err"
  jq -nc --arg since "$1" --argjson merges "$2" --argjson segments "$3" --argjson reviewer "$reviewer" \
    '{since: $since, segments: $segments, merges: $merges, reviewer: $reviewer}'
}

ref="refs/remotes/origin/$base"
git rev-parse --verify --quiet "$ref^{commit}" >/dev/null \
  || { echo "review-range: origin/$base not found; fetch it first" >&2; exit 1; }
since=$(git rev-parse --verify --quiet "$since^{commit}") \
  || { echo "review-range: $2 is not a commit here" >&2; exit 1; }
git merge-base --is-ancestor "$since" HEAD \
  || { echo "review-range: $since is not an ancestor of HEAD" >&2; exit 1; }
if [ "$(git merge-base --all "$ref" HEAD)" = "$since" ]; then
  answer "$since" '[]' '[]'
  exit 0
fi
# Segments are diffs along HEAD's first-parent line; from a SINCE off that line
# (a commit merged in from a side branch) they would compare unrelated trees.
git rev-list --first-parent HEAD | grep -x "$since" >/dev/null \
  || { echo "review-range: $since is not on HEAD's first-parent line" >&2; exit 1; }

# The branch's own line, oldest first, each commit with its parents.
merges=()
segments=()
from=$since
while read -r commit first others; do
  [ -n "${others:-}" ] || continue
  on_base=true
  for p in $others; do
    git merge-base --is-ancestor "$p" "$ref" || on_base=false
  done
  $on_base || continue
  merges+=("$commit")
  [ "$from" != "$first" ] && segments+=("$from $first")
  from=$commit
done < <(git rev-list --reverse --first-parent --parents "$since..HEAD")

answer "$from" \
  "$(printf '%s\n' "${merges[@]+"${merges[@]}"}" | jq -R 'select(length > 0)' | jq -sc .)" \
  "$(printf '%s\n' "${segments[@]+"${segments[@]}"}" | jq -R 'select(length > 0) | split(" ") | {since: .[0], head: .[1]}' | jq -sc .)"
