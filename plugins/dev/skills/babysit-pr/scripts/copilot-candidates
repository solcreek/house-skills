#!/usr/bin/env bash
# copilot-candidates OWNER/REPO BRANCH COMMIT
#
# The locations Copilot considered when it reviewed COMMIT, read from its
# review run's log. A Copilot review can claim findings it never posts ("five
# moderate findings and two nits remain" over "0 open findings"); the log
# names each candidate it stored, by file and line, without its text:
#
#   CCR Agent: Comment stored (id=001, type=bug, file=a.ts, start=27, end=29, fixed=false, severity=moderate)
#
# Prints NDJSON, one candidate per line, duplicates dropped:
#   {"path": "a.ts", "start": 27, "end": 29, "type": "bug", "severity": "moderate", "fixed": false}
# Candidates include the ones Copilot did post as threads. `fixed` is the log's
# own flag, null when absent or neither true nor false; of 294 stored lines across 64
# runs none read true (2026-10-13), so what true means is unobserved. A
# location stored twice keeps its fixed=false entry.
#
# The log is CI output of a trusted review bot, but it can echo what the PR
# put there, so only a line the agent itself wrote counts — a log line's
# timestamp, then the marker — and only its locations reach the caller: a
# relative path inside the checkout (no whitespace or control characters, no
# leading /, no . or .. component), numeric lines, a lower-case type and
# severity. The fields are read in the log's own order, as one pattern, so a
# path holding ", " or ")" is read whole rather than cut short. A line that
# fails this is dropped and counted on stderr.
#
# Exit codes: 0 the candidates (none is an empty answer) · 3 no completed
# Copilot run for COMMIT, or its log has expired · 1 a read failed, or no
# stored line parsed (the log's format changed) · 2 usage
set -euo pipefail

usage="usage: copilot-candidates OWNER/REPO BRANCH COMMIT"
repo=${1:?$usage}
branch=${2:?$usage}
commit=${3:?$usage}
[[ "$repo" == */* ]] || { echo "$usage" >&2; exit 2; }
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || { echo "copilot-candidates: COMMIT must be a full sha" >&2; exit 2; }
command -v jq >/dev/null || { echo "copilot-candidates needs jq" >&2; exit 1; }

runs=$(gh api -X GET "repos/$repo/actions/runs" -f branch="$branch" -f event=dynamic -f head_sha="$commit" -f per_page=100) \
  || { echo "copilot-candidates: could not list the runs for $commit" >&2; exit 1; }
run=$(jq -r '[.workflow_runs[]? | select(.path == "dynamic/agents/copilot-pull-request-reviewer" and .status == "completed")]
             | sort_by(.created_at) | last | .id // empty' <<<"$runs")
[ -n "$run" ] || { echo '{"run": null}'; exit 3; }

# `gh run view --log`, not the jobs/logs API: gh api refuses a body carrying
# terminal escape sequences, which this log does.
log=$(gh run view "$run" --repo "$repo" --log 2>/dev/null) || { echo "{\"run\": $run, \"log\": null}"; exit 3; }

# gh prints "job<TAB>step<TAB><timestamp> <message>"; the message may open
# with colour codes.
tab=$'\t' esc=$'\e'
marker="^[^$tab]*$tab[^$tab]*$tab[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z ($esc\\[[0-9;]*m)*CCR Agent: Comment stored \\("
stored=$(grep -E "$marker.*\\)" <<<"$log" | sed -E -e "s/$marker//" -e 's/\)[^)]*$//' || true)
[ -n "$stored" ] || exit 0
out=$(jq -Rnc '[inputs | capture("^id=[0-9]+, type=(?<type>[a-z_]+), file=(?<file>.*), start=(?<start>[0-9]+), end=(?<end>[0-9]+)(, fixed=(?<fixed>[a-z]+))?, severity=(?<severity>[a-z_]+)$") // {}]
        | length as $n
        | (map(select(.file)) | length) as $parsed
        | map(select(.file // "" | test("^[^[:space:][:cntrl:]]+$") and (test("^/|(^|/)\\.\\.?(/|$)") | not))
              | {path: .file, start: (.start | tonumber), end: (.end | tonumber), type, severity,
                 fixed: ({"true": true, "false": false}[.fixed // ""])})
        | {parsed: $parsed, dropped: ($n - length),
           candidates: group_by([.path, .start, .end, .type]) | map(min_by(.fixed == true))}' <<<"$stored")
dropped=$(jq -r .dropped <<<"$out")
if [ "$(jq .parsed <<<"$out")" -eq 0 ]; then
  echo "copilot-candidates: none of $dropped stored line(s) parsed; the log's format may have changed" >&2
  exit 1
fi
[ "$dropped" -eq 0 ] || echo "copilot-candidates: dropped $dropped stored line(s) that were not a plain location" >&2
jq -c '.candidates[]' <<<"$out"
