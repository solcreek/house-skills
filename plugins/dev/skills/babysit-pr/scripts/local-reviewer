#!/usr/bin/env bash
# local-reviewer BASE SINCE
#
# The reviewer a repository declares for step 5, in place of the subagent: the
# `reviewer` capability of repo-commands, which says where and how a repository
# declares one:
#
#   ```babysit-pr-reviewer
#   pnpm -s review:ai --base {since} --format text
#   ```
#
# {since} is replaced with SINCE, the first commit the review must not cover.
# The command exits 0 when the review ran to completion, whatever it found, and
# non-zero when it did not.
#
# Prints one JSON line. Exit codes:
#   0  {"command": "...", "source": "AGENTS.md"} — run this command
#   3  {"declared": false} — nothing declared; use the subagent
#   4  a broken declaration (message on stderr)
#   1  could not look (message on stderr)
#   2  usage
set -euo pipefail

usage="usage: local-reviewer BASE SINCE"
base=${1:?$usage}
since=${2:?$usage}
[[ "$since" =~ ^[0-9a-f]{7,40}$ ]] || { echo "local-reviewer: SINCE must be a commit sha" >&2; exit 2; }
command -v jq >/dev/null || { echo "local-reviewer needs jq" >&2; exit 1; }
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

rc=0
all=$("$here/repo-commands" "$base") || rc=$?
case $rc in
  0 | 3) ;;
  *) exit 1 ;;
esac
reviewer=$(jq -c '.reviewer' <<<"$all")
if [ "$reviewer" = null ]; then
  echo '{"declared": false}'
  exit 3
fi
if [ "$(jq -r '.command == null' <<<"$reviewer")" = true ]; then
  echo "local-reviewer: $(jq -r .why <<<"$reviewer")" >&2
  exit 4
fi
jq -c --arg since "$since" '{command: (.command | gsub("\\{since\\}"; $since)), source}' <<<"$reviewer"
