#!/usr/bin/env bash
# ci-log OWNER/REPO RUN_ID
#
# The failed steps' log of workflow run RUN_ID, short enough to read: the last
# BABYSIT_LOG_LINES lines (default 200) of each failed job, so a second failed
# job is never cut off by the first one's output. Each job and step is named
# once on a "== JOB / STEP" line, ahead of its lines, with timestamps and colour
# codes removed.
#
# Exit codes: 0 the log, as text · 3 {"run": RUN_ID, "log": null}: the run has
# no failed step to show · 1 could not look: the run is still in progress, its
# logs expired, or gh failed (message on stderr) · 2 usage
set -euo pipefail

usage="usage: ci-log OWNER/REPO RUN_ID"
repo=${1:?$usage}
run=${2:?$usage}
[[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || { echo "ci-log: OWNER/REPO must look like owner/name" >&2; exit 2; }
[[ "$run" =~ ^[0-9]+$ ]] || { echo "ci-log: RUN_ID must be a run id" >&2; exit 2; }
lines=${BABYSIT_LOG_LINES:-200}
[[ "$lines" =~ ^[1-9][0-9]*$ ]] || { echo "ci-log: BABYSIT_LOG_LINES must be a whole number above 0" >&2; exit 2; }

log=$(mktemp)
trap 'rm -f "$log"' EXIT
gh run view "$run" -R "$repo" --log-failed > "$log" \
  || { echo "ci-log: could not read the failed log of run $run" >&2; exit 1; }
if [ ! -s "$log" ]; then
  echo "{\"run\": $run, \"log\": null}"
  exit 3
fi

# gh prints JOB<TAB>STEP<TAB>TIMESTAMP TEXT per line.
awk -F '\t' -v keep="$lines" '
  {
    job = $1; step = $2
    text = $0; sub(/^[^\t]*\t[^\t]*\t/, "", text)
    sub(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9:.]*Z ?/, "", text)
    gsub(/\033\[[0-9;]*[A-Za-z]/, "", text)
    if (!(job in count)) order[++jobs] = job
    n = ++count[job]
    steps[job, n] = step; texts[job, n] = text
    # Only the last keep lines of a job are printed: memory stays at that, not the log.
    if (n > keep) { delete steps[job, n - keep]; delete texts[job, n - keep] }
  }
  END {
    for (k = 1; k <= jobs; k++) {
      job = order[k]; first = count[job] - keep + 1
      if (first < 1) first = 1
      if (k > 1) print ""
      if (first > 1) printf "(%d earlier lines of %s left out)\n", first - 1, job
      shown = ""
      for (i = first; i <= count[job]; i++) {
        if (steps[job, i] != shown) { print "== " job " / " steps[job, i]; shown = steps[job, i] }
        print texts[job, i]
      }
    }
  }' "$log"
