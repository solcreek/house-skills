#!/usr/bin/env bash
# checkout-pr NUMBER BRANCH
#
# Gets this checkout onto pull request NUMBER's head branch BRANCH, level with
# origin/BRANCH, or says that a plain checkout is needed. git refuses to check
# out a branch that another worktree holds, so `gh pr checkout` cannot help
# there: the PR's head goes onto a local branch of another name,
# babysit-pr-NUMBER, and every push names the PR's branch explicitly
# (git push origin HEAD:BRANCH).
#
# Prints one JSON line {"local": ..., "branch": BRANCH, "action": ..., "sync": ...}:
#   action here       already on BRANCH, or on babysit-pr-NUMBER
#          elsewhere  BRANCH is checked out in "worktree"; now on
#                     babysit-pr-NUMBER (created at origin/BRANCH, or left by an
#                     earlier run and switched to as it is)
#   sync   same            the local branch is origin/BRANCH
#          fast-forwarded  it was behind and now is origin/BRANCH
#          ahead           it holds "ahead" commits origin/BRANCH lacks (an
#                          earlier run's, never pushed)
# Exit codes: 0 one of the above · 5 {"action": "checkout"}: nothing holds
# BRANCH; check it out the usual way, then run this again · 3 refused: local
# changes in this worktree, or the local branch has diverged from origin/BRANCH
# (HEAD left where it was) · 1 failed (message on stderr) · 2 usage
set -euo pipefail

usage="usage: checkout-pr NUMBER BRANCH"
number=${1:?$usage}
branch=${2:?$usage}
[[ "$number" =~ ^[0-9]+$ ]] || { echo "checkout-pr: NUMBER must be a PR number" >&2; exit 2; }
git check-ref-format --branch "$branch" >/dev/null 2>&1 || { echo "checkout-pr: $branch is not a branch name" >&2; exit 2; }
command -v jq >/dev/null || { echo "checkout-pr needs jq" >&2; exit 1; }

local_name="babysit-pr-$number"
remote="refs/remotes/origin/$branch"

fetch() {
  git fetch --quiet origin "+refs/heads/$branch:$remote" \
    || { echo "checkout-pr: could not fetch $branch from origin" >&2; exit 1; }
}

# refuse_diverged REF LOCAL — exit 3 when REF and origin/BRANCH each hold commits the other lacks
refuse_diverged() {
  git merge-base --is-ancestor "$1" "$remote" && return 0
  git merge-base --is-ancestor "$remote" "$1" && return 0
  jq -nc --arg l "$2" --arg b "$branch" \
    '{action: "refused", why: "\($l) has diverged from origin/\($b)"}'
  exit 3
}

# land LOCAL ACTION [WORKTREE] — brings LOCAL level with origin/BRANCH and says so
land() {
  local sync ahead=0
  refuse_diverged HEAD "$1"
  if [ "$(git rev-parse HEAD)" = "$(git rev-parse "$remote")" ]; then
    sync=same
  elif git merge-base --is-ancestor HEAD "$remote"; then
    git merge --quiet --ff-only "$remote" >/dev/null \
      || { echo "checkout-pr: could not fast-forward $1 to origin/$branch" >&2; exit 1; }
    sync=fast-forwarded
  else
    sync=ahead
    ahead=$(git rev-list --count "$remote..HEAD")
  fi
  jq -nc --arg l "$1" --arg b "$branch" --arg a "$2" --arg w "${3:-}" --arg s "$sync" --argjson n "$ahead" \
    '{local: $l, branch: $b, action: $a} + (if $w == "" then {} else {worktree: $w} end)
     + {sync: $s} + (if $s == "ahead" then {ahead: $n} else {} end)'
}

if [ -n "$(git status --porcelain)" ]; then
  echo '{"action": "refused", "why": "this worktree has local changes"}'
  exit 3
fi
current=$(git symbolic-ref --quiet --short HEAD || true)
if [ "$current" = "$branch" ] || [ "$current" = "$local_name" ]; then
  fetch
  land "$current" here
  exit 0
fi

top=$(git rev-parse --show-toplevel)
holder=$(git worktree list --porcelain | awk -v ref="refs/heads/$branch" '
  /^worktree / { wt = substr($0, 10) }
  $0 == "branch " ref { print wt; exit }')
if [ -z "$holder" ] || [ "$holder" = "$top" ]; then
  echo '{"action": "checkout"}'
  exit 5
fi

fetch
if git rev-parse --verify --quiet "refs/heads/$local_name" >/dev/null; then
  # Refused before the switch, so the refusal leaves this checkout where it was.
  refuse_diverged "refs/heads/$local_name" "$local_name"
  git switch --quiet "$local_name" || { echo "checkout-pr: could not switch to $local_name" >&2; exit 1; }
else
  git switch --quiet --no-track -c "$local_name" "$remote" \
    || { echo "checkout-pr: could not create $local_name" >&2; exit 1; }
fi
land "$local_name" elsewhere "$holder"
