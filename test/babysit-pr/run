gitc() { git -C "$caps" -c user.name=t -c user.email=t@t -c commit.gpgsign=false "$@"; }
caps_base() { # caps_base FILE TEXT — commits FILE on main and publishes it as origin/main
  printf '%s\n' "$2" > "$caps/$1"
  gitc add -A && gitc commit -qm "$1" && gitc update-ref refs/remotes/origin/main HEAD
}
declared() { # declared NAME EXIT ASSERTION ARGS... — runs repo-commands ARGS; ASSERTION "-" checks only EXIT
  local out rc=0
  out=$(cd "$caps" && "$rc_" "${@:4}" 2>&1) || rc=$?
  if [ "$rc" -eq "$2" ] && { [ "$3" = - ] || jq -e "$3" <<<"$out" >/dev/null 2>&1; }; then
    echo "ok   $1"; pass=$((pass + 1))
  else
    echo "FAIL $1"; echo "     exit $rc, wanted $2: $out"; fail=$((fail + 1))
  fi
}
