gito switch -q main
gito worktree add -q "$tmp/held" feat
checkout "another worktree holds the branch: a local branch of another name, at the PR's head" "$co" 0 \
  '. == {local: "babysit-pr-7", branch: "feat", action: "elsewhere", worktree: "'"$(cd "$tmp/held" && pwd -P)"'", sync: "same"}'
if [ "$(gito symbolic-ref --short HEAD)" = babysit-pr-7 ] && [ "$(gito rev-parse HEAD)" = "$FEAT" ] \
  && [ -z "$(gito config branch.babysit-pr-7.merge || true)" ]; then
  echo "ok   now on babysit-pr-7 at origin/feat, tracking nothing a bare push could hit"; pass=$((pass + 1))
else echo "FAIL not on babysit-pr-7 at $FEAT: $(gito rev-parse --abbrev-ref HEAD) $(gito rev-parse HEAD)"; fail=$((fail + 1)); fi
echo z > "$co/z" && gito add z && gito commit -qm z
gito push -q origin HEAD:feat
if [ "$(git -C "$origin" rev-parse feat)" = "$(gito rev-parse HEAD)" ]; then
  echo "ok   git push origin HEAD:feat from babysit-pr-7 updates the PR's branch"; pass=$((pass + 1))
else echo "FAIL the push did not reach feat"; fail=$((fail + 1)); fi
checkout "on babysit-pr-7 again: here" "$co" 0 '. == {local: "babysit-pr-7", branch: "feat", action: "here", sync: "same"}'
gito switch -q main
checkout "a babysit-pr-7 left by an earlier run is reused" "$co" 0 '.local == "babysit-pr-7" and .action == "elsewhere"'
gito switch -q main
echo dirty > "$co/x"
checkout "local changes are refused" "$co" 3 '.action == "refused"'
gito checkout -q -- x
gito switch -q babysit-pr-7
echo dirty > "$co/x"
checkout "local changes are refused on the PR's own branch too" "$co" 3 '.action == "refused"'
gito checkout -q -- x
gito switch -q main
other="$tmp/other"
git clone -q -b feat "$origin" "$other" 2>/dev/null
pushes() { # pushes NAME — someone else pushes a commit touching NAME to the PR's branch
  echo "$1" > "$other/$1"
  git -C "$other" add "$1" && git -C "$other" -c user.name=t -c user.email=t@t -c commit.gpgsign=false commit -qm "$1" \
    && git -C "$other" push -q origin feat
}
pushes w
checkout "behind the PR's branch: fast-forwarded to it" "$co" 0 \
  '.local == "babysit-pr-7" and .action == "elsewhere" and .sync == "fast-forwarded"'
if [ "$(gito rev-parse HEAD)" = "$(git -C "$origin" rev-parse feat)" ]; then
  echo "ok   the fast-forward lands on the PR's head"; pass=$((pass + 1))
else echo "FAIL not at the PR's head after the fast-forward"; fail=$((fail + 1)); fi
echo a > "$co/a" && gito add a && gito commit -qm a
checkout "an earlier run's unpushed commit: ahead, counted, kept" "$co" 0 \
  '. == {local: "babysit-pr-7", branch: "feat", action: "here", sync: "ahead", ahead: 1}'
AHEAD=$(gito rev-parse HEAD)
pushes w2
checkout "diverged from the PR's branch: refused, nothing moved" "$co" 3 \
  '.action == "refused" and (.why | test("babysit-pr-7 has diverged from origin/feat"))'
if [ "$(gito rev-parse HEAD)" = "$AHEAD" ]; then
  echo "ok   a refused divergence leaves the local branch as it was"; pass=$((pass + 1))
else echo "FAIL the divergence moved HEAD"; fail=$((fail + 1)); fi
gito switch -q main
checkout "a diverged babysit-pr-7 left by an earlier run is refused from another branch too" "$co" 3 \
  '.action == "refused" and (.why | test("babysit-pr-7 has diverged"))'
if [ "$(gito symbolic-ref --short HEAD)" = main ]; then
  echo "ok   that refusal comes before the switch: the checkout stays on main"; pass=$((pass + 1))
else echo "FAIL the refusal switched to $(gito symbolic-ref --short HEAD)"; fail=$((fail + 1)); fi

echo "== review-range"
rr="$root/plugins/dev/skills/babysit-pr/scripts/review-range"
range="$tmp/range"
git init -q -b main "$range"
gitg() { git -C "$range" -c user.name=t -c user.email=t@t -c commit.gpgsign=false "$@"; }
commit() { # commit NAME — a commit touching NAME on the current branch; prints its sha
  echo "$1" > "$range/$1"; gitg add "$1" && gitg commit -qm "$1" && gitg rev-parse HEAD
}
base_moves() { # base_moves NAME — a commit on main, published as origin/main
  gitg switch -q main && commit "$1" >/dev/null && gitg update-ref refs/remotes/origin/main main && gitg switch -q feat
}
merge_base() { # merge_base — merges origin/main into feat; prints the merge's sha
  gitg merge -q --no-ff -m "merge main" origin/main && gitg rev-parse HEAD
}
ranged() { # ranged NAME SINCE ASSERTION — runs review-range main SINCE on feat
  local out rc=0
  out=$(cd "$range" && "$rr" main "$2" 2>&1) || rc=$?
  if [ "$rc" -eq 0 ] && jq -e "$3" <<<"$out" >/dev/null 2>&1; then
    echo "ok   $1"; pass=$((pass + 1))
  else
    echo "FAIL $1"; echo "     exit $rc: $out"; fail=$((fail + 1))
  fi
}
commit c0 >/dev/null
gitg update-ref refs/remotes/origin/main main
gitg switch -q -c feat
f1=$(commit f1)
f2=$(commit f2)
ranged "no merge: the whole range goes to the reviewer" "$f1" \
  'del(.reviewer) == {since: "'"$f1"'", segments: [], merges: []}'
base_moves m1
M1=$(merge_base)
ranged "a merge right after SINCE: only the commits after it, plus its resolution" "$f2" \
  'del(.reviewer) == {since: "'"$M1"'", segments: [], merges: ["'"$M1"'"]}'
f3=$(commit f3)
ranged "own commits before the merge become a segment" "$f1" \
  'del(.reviewer) == {since: "'"$M1"'", segments: [{since: "'"$f1"'", head: "'"$f2"'"}], merges: ["'"$M1"'"]}'
base_moves m2
M2=$(merge_base)
f4=$(commit f4)
ranged "two merges: a segment before each, the reviewer after the last" "$f1" \
  'del(.reviewer) == {since: "'"$M2"'", segments: [{since: "'"$f1"'", head: "'"$f2"'"}, {since: "'"$M1"'", head: "'"$f3"'"}], merges: ["'"$M1"'", "'"$M2"'"]}'
mb=$(gitg merge-base origin/main feat)
ranged "the merge base as SINCE needs no split, though merges left it off the first-parent line" "$mb" \
  'del(.reviewer) == {since: "'"$mb"'", segments: [], merges: []}'
