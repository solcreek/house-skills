if [ "$rc" -eq 2 ]; then echo "ok   SINCE must be a sha"; pass=$((pass + 1))
else echo "FAIL SINCE must be a sha: exit $rc: $out"; fail=$((fail + 1)); fi

echo "== repo-commands"
rc_="$root/plugins/dev/skills/babysit-pr/scripts/repo-commands"
caps="$tmp/caps"
