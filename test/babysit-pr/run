gito() { git -C "$co" -c user.name=t -c user.email=t@t -c commit.gpgsign=false "$@"; }
echo x > "$co/x" && gito add x && gito commit -qm x && gito push -q origin main
gito switch -q -c feat && echo y > "$co/y" && gito add y && gito commit -qm y && gito push -q origin feat
FEAT=$(gito rev-parse HEAD)
gito switch -q main
checkout() { # checkout NAME DIR EXIT ASSERTION — runs checkout-pr 7 feat in DIR
  local out rc=0
  out=$(cd "$2" && "$cp_" 7 feat 2>&1) || rc=$?
  if [ "$rc" -eq "$3" ] && jq -e "$4" <<<"$out" >/dev/null 2>&1; then
    echo "ok   $1"; pass=$((pass + 1))
  else
    echo "FAIL $1"; echo "     exit $rc, wanted $3: $out"; fail=$((fail + 1))
  fi
}
checkout "nothing holds the branch: exit 5, check it out the usual way" "$co" 5 '.action == "checkout"'
gito switch -q feat
