if [ "$rc" -eq 0 ] && jq -e 'del(.reviewer) == {since: "'"$mb"'", segments: [], merges: []}' <<<"$out" >/dev/null 2>&1; then
  echo "ok   without SINCE, the merge base is SINCE: no separate merge-base call"; pass=$((pass + 1))
else echo "FAIL no SINCE: exit $rc: $out"; fail=$((fail + 1)); fi
gitg switch -q -c side "$f1"
s1=$(commit s1)
gitg switch -q feat
gitg merge -q --no-ff -m "merge side" side
