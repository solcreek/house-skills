#!/usr/bin/env bash
# A tool that breaks each convention: help on stderr with exit 1, colour
# regardless of the terminal or NO_COLOR, --version falling through to help,
# unknown flags ignored, a help line far too wide, and two JSON documents.
help() { printf '\033[1musage:\033[0m bad %s\n' "$(printf 'x%.0s' $(seq 1 120))" >&2; }
case "${1:-}" in
  -h|--help) help; exit 1 ;;
  --version) printf '\033[1musage:\033[0m bad\n' ;;
  --json) echo '{"a": 1}'; echo '{"b": 2}' ;;
  *) echo "did the thing anyway" ;;
esac
