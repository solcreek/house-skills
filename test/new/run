#!/usr/bin/env bash
# Tests for cli:new's scaffold. For each stack whose toolchain is installed,
# scaffolds a CLI named `my-cli`, runs the template's own contract tests, and
# probes the binary with cli:audit's probe: a new CLI must pass it with no
# failure. Rust and Go fetch dependencies, so this needs the network.
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
scaffold="$root/plugins/cli/skills/new/scripts/scaffold"
probe="$root/plugins/cli/skills/audit/scripts/probe"
runjson="$root/plugins/cli/skills/audit/scripts/run-json"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
pass=0
fail=0
ok() { pass=$((pass + 1)); }
no() { echo "FAIL $1"; fail=$((fail + 1)); }

# Usage and refusals, no toolchain needed.
for args in "" "cobol $tmp/x my-cli" "go $tmp/x My_CLI" "go $tmp/x"; do
  got=0
  # shellcheck disable=SC2086
  "$scaffold" $args > /dev/null 2>&1 || got=$?
  [ "$got" = 64 ] && ok || no "usage '$args': exit $got, want 64"
done
mkdir "$tmp/full"; touch "$tmp/full/x"
got=0; out=$("$scaffold" typescript "$tmp/full" my-cli) || got=$?
[ "$got" = 2 ] && echo "$out" | jq -e '.error | test("not an empty directory")' > /dev/null && ok || no "non-empty dir: exit $got, $out"
got=0; out=$("$scaffold" typescript "$tmp/full/x/y" my-cli) || got=$?
[ "$got" = 2 ] && echo "$out" | jq -e '.error | test("not an empty directory|cannot create")' > /dev/null && ok || no "dir under a file: exit $got, $out"

# A step that fails answers in JSON, exit 1, and removes the DIR it made.
# A stub go that fails `go get` stands in for a network failure.
mkdir -p "$tmp/stub"
printf '#!/bin/sh
[ "$1" = get ] && { echo "dial tcp: no route" >&2; exit 1; }
exit 0
' > "$tmp/stub/go"
chmod +x "$tmp/stub/go"
got=0; out=$(PATH="$tmp/stub:$PATH" "$scaffold" go "$tmp/failing" my-cli) || got=$?
if [ "$got" = 1 ] && echo "$out" | jq -e '.error and (.log | test("no route"))' > /dev/null && [ ! -e "$tmp/failing" ]; then ok
else no "failed step: exit $got, $out, dir left: $(ls -d "$tmp/failing" 2>/dev/null)"; fi
if command -v cargo > /dev/null; then
  got=0; out=$("$scaffold" rust "$tmp/r" test) || got=$?
  [ "$got" = 2 ] && [ ! -e "$tmp/r" ] && ok || no "reserved rust name: exit $got, $out"
fi

for stack in typescript rust go; do
  case "$stack" in typescript) need=node ;; rust) need=cargo ;; go) need=go ;; esac
  if ! command -v "$need" > /dev/null; then echo "SKIP $stack: no $need"; continue; fi
  d="$tmp/$stack"
  got=0; out=$("$scaffold" "$stack" "$d" my-cli) || got=$?
  if [ "$got" != 0 ]; then no "$stack scaffold: exit $got: $out"; continue; fi
  ok

  # The placeholder is gone everywhere.
  if grep -rlw tool "$d" --exclude-dir=target > /dev/null 2>&1; then
    no "$stack: placeholder left in $(grep -rlw tool "$d" --exclude-dir=target | tr '\n' ' ')"
  else ok; fi

  # The binary is absolute, so the probe works from any directory.
  case "$(echo "$out" | jq -r .binary)" in /*) ok ;; *) no "$stack: binary is not absolute" ;; esac
  build=$(echo "$out" | jq -r '.build // empty')
  test=$(echo "$out" | jq -r .test)
  bin=$(echo "$out" | jq -r .binary)
  if [ -n "$build" ] && ! (cd "$d" && $build) > "$tmp/log" 2>&1; then no "$stack build"; tail -20 "$tmp/log"; continue; fi
  if (cd "$d" && $test) > "$tmp/log" 2>&1; then ok; else no "$stack contract tests"; tail -30 "$tmp/log"; fi

  # greet and touch take a free positional, so an unknown subcommand there
  # is an argument; describe takes none, so it gets every check.
  for level in "top" "greet --skip unknown-command" "touch --skip unknown-command" "describe"; do
    set -- $level
    lvl=$1; shift
    [ "$lvl" = top ] && lvl=
    # shellcheck disable=SC2086
    if "$probe" "$@" -- "$bin" $lvl > "$tmp/p" 2>&1; then ok
    else no "$stack probe '$level': $(jq -c '[.checks[]? | select(.status == "fail") | [.id, .detail]]' "$tmp/p" 2>/dev/null || cat "$tmp/p")"; fi
  done
  if "$runjson" -- "$bin" greet Ada --json > "$tmp/p" 2>&1; then ok; else no "$stack greet --json"; fi
  # A mutating command under --dry-run is read-only; its failures are JSON too.
  if "$runjson" -- "$bin" touch x --dry-run --json > "$tmp/p" 2>&1; then ok; else no "$stack touch --dry-run --json: $(cat "$tmp/p")"; fi
  if "$runjson" --expect-exit 2 -- "$bin" touch x --json > "$tmp/p" 2>&1; then ok; else no "$stack touch without --yes: $(jq -c '[.checks[] | select(.status == "fail")]' "$tmp/p")"; fi
  if "$runjson" --expect-exit 1 -- "$bin" touch ../x --yes --json > "$tmp/p" 2>&1; then ok; else no "$stack touch ../x: $(jq -c '[.checks[] | select(.status == "fail")]' "$tmp/p")"; fi
  # describe: one document, in the shared shape (references/describe.md).
  # run-json keeps only 2000 bytes of stdout, so read the whole document directly.
  if "$runjson" -- "$bin" describe > "$tmp/p" 2>&1 && "$bin" describe > "$tmp/d" &&
     jq -e '
       (.name == "my-cli") and (.version | type == "string") and (.summary | type == "string")
       and .exitCodes.ok == 0 and .exitCodes.failed == 1 and .exitCodes.usage == 2
       and ([.flags[].name] | index("version") != null)
       and all(.flags[], .commands[].flags[]; has("name") and has("short") and has("takesValue") and has("default") and has("description"))
       and all(.commands[]; (.mutates | type == "boolean") and (.summary | type == "string") and (.commands | type == "array"))
       and (.commands[] | select(.name == "greet") | (.usage | test("greet")) and .mutates == false
            and ([.flags[].name] | index("json") != null and index("help") != null))
       and (.commands[] | select(.name == "touch") | .mutates
            and ([.flags[].name] | index("dry-run") != null and index("yes") != null))' "$tmp/d" > /dev/null; then ok
  else no "$stack describe shape: $(head -c 600 "$tmp/d")"; fi
done

echo "$pass passed, $fail failed"
[ "$fail" -eq 0 ]
